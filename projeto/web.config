<?xml version="1.0" encoding="UTF-8"?>
<!-- quando um endereço dentro do projeto não existe, o IIS mostra a 404.php em vez da página dele -->
<configuration>
    <system.webServer>
        <httpErrors errorMode="Custom">
            <remove statusCode="404" subStatusCode="-1" />
            <error statusCode="404" path="/tesp-ds-g17/projeto/404.php" responseMode="ExecuteURL" />
        </httpErrors>
    </system.webServer>
</configuration>
