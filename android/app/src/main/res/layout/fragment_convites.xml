<?xml version="1.0" encoding="utf-8"?>
<ScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:paddingStart="16dp"
        android:paddingTop="20dp"
        android:paddingEnd="16dp"
        android:paddingBottom="16dp">

        <TextView
            style="@style/Titulo"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="Convites" />

        <ProgressBar
            android:id="@+id/carregar"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_gravity="center_horizontal"
            android:layout_marginTop="16dp" />

        <TextView
            android:id="@+id/erro"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="16dp"
            android:background="@drawable/caixa"
            android:padding="12dp"
            android:visibility="gone" />

        <TextView
            style="@style/Subtitulo"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="Recebidos" />

        <LinearLayout
            android:id="@+id/recebidos"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical" />

        <TextView
            android:id="@+id/sem_recebidos"
            style="@style/TextoDim"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="Ainda não recebeste convites."
            android:visibility="gone" />

        <TextView
            style="@style/Subtitulo"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="Avisos" />

        <LinearLayout
            android:id="@+id/avisos"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical" />

        <TextView
            android:id="@+id/sem_avisos"
            style="@style/TextoDim"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="Sem avisos."
            android:visibility="gone" />

        <TextView
            style="@style/Subtitulo"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="Enviados" />

        <LinearLayout
            android:id="@+id/enviados"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical" />

        <TextView
            android:id="@+id/sem_enviados"
            style="@style/TextoDim"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="Ainda não enviaste convites. Para convidar alguém usa o site."
            android:visibility="gone" />
    </LinearLayout>
</ScrollView>
