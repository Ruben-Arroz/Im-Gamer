<?xml version="1.0" encoding="utf-8"?>
<ScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@+id/main"
    android:layout_width="match_parent"
    android:layout_height="match_parent">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:padding="16dp">

        <ProgressBar
            android:id="@+id/carregar"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_gravity="center_horizontal" />

        <TextView
            android:id="@+id/erro"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:background="@drawable/caixa"
            android:padding="12dp"
            android:visibility="gone" />

        <LinearLayout
            android:id="@+id/conteudo"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:visibility="gone">

            <ImageView
                android:id="@+id/imagem"
                android:layout_width="match_parent"
                android:layout_height="170dp"
                android:contentDescription="Capa do jogo"
                android:scaleType="centerCrop" />

            <TextView
                android:id="@+id/nome"
                style="@style/Titulo"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="16dp" />

            <TextView
                android:id="@+id/detalhes"
                style="@style/TextoDim"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="8dp" />

            <TextView
                android:id="@+id/media"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="8dp"
                android:textSize="16sp" />

            <TextView
                android:id="@+id/descricao"
                style="@style/TextoDim"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="12dp"
                android:lineSpacingExtra="4dp" />

            <TextView
                android:id="@+id/titulo_avaliar"
                style="@style/Subtitulo"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="Avaliar este jogo" />

            <RatingBar
                android:id="@+id/estrelas"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:numStars="5"
                android:progressBackgroundTint="@color/borda"
                android:progressTint="@color/texto"
                android:rating="5"
                android:stepSize="1" />

            <EditText
                android:id="@+id/comentario"
                style="@style/Campo"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="12dp"
                android:gravity="top"
                android:hint="Comentário (opcional)"
                android:importantForAutofill="no"
                android:inputType="textMultiLine|textCapSentences"
                android:maxLength="1000"
                android:minLines="3" />

            <TextView
                android:id="@+id/mensagem"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="12dp"
                android:background="@drawable/caixa"
                android:padding="12dp"
                android:visibility="gone" />

            <Button
                android:id="@+id/guardar"
                style="@style/Botao"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="12dp"
                android:text="Guardar avaliação" />

            <Button
                android:id="@+id/apagar"
                style="@style/BotaoContorno"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="Apagar a minha avaliação"
                android:visibility="gone" />

            <TextView
                style="@style/Subtitulo"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="Avaliações" />

            <LinearLayout
                android:id="@+id/avaliacoes"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical" />

            <TextView
                android:id="@+id/sem_avaliacoes"
                style="@style/TextoDim"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="Ainda ninguém avaliou este jogo." />
        </LinearLayout>
    </LinearLayout>
</ScrollView>
