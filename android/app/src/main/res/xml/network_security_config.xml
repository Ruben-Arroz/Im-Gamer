<?xml version="1.0" encoding="utf-8"?>
<!-- o android só deixa ligações https. a exceção é o 10.0.2.2, que no emulador é o pc,
     para testar com o site a correr no pc (php -S, sem https) -->
<network-security-config>
    <domain-config cleartextTrafficPermitted="true">
        <domain includeSubdomains="false">10.0.2.2</domain>
    </domain-config>
</network-security-config>
